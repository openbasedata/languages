{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openbasedata/languages/main/data.schema.json",
  "title": "Open Base Data Languages",
  "description": "Schema for data.json language entries.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["code", "name", "nativeName", "population"],
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[a-z]{2}(?:-[A-Za-z0-9]{2,8})*$",
        "description": "Language code (ISO 639-1 or extended language/script variant form)."
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "English language name."
      },
      "nativeName": {
        "type": "string",
        "minLength": 1,
        "description": "Native/self language name."
      },
      "population": {
        "type": "integer",
        "minimum": 0,
        "description": "Estimated speaker population (0 means no reliable estimate)."
      }
    },
    "additionalProperties": false
  }
}
